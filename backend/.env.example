ANTHROPIC_API_KEY=
MODEL=anthropic:claude-sonnet-4-5

# Registry (see README). Tokens come from `python -m registry_service.bootstrap`.
REGISTRY_URL=http://127.0.0.1:8800
REGISTRY_TOKEN=            # the agent-guide token
REGISTRY_PUBKEY_FILE=      # registry public key, pinned out of band; required outside dev
OUTPUT_FILE_SIGNING_KEY=   # optional stable key for signed deliverable URLs across restarts
AGENT_ID=platform-guide
SKILL_ENV=dev              # dev | uat | prod
REDIS_URL=redis://127.0.0.1:6379/0
TOOL_HOST_ALLOWLIST=127.0.0.1:8810
